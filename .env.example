# Copiar a .env y ajustar si hace falta. No subir .env con datos reales.

POSTGRES_USER=refri
POSTGRES_PASSWORD=refri
POSTGRES_DB=refri

# Usada por el backend (SQLAlchemy + driver psycopg 3). Dentro de docker compose el
# host es "db"; para correr el backend fuera de docker compose, usar "localhost".
DATABASE_URL=postgresql+psycopg://refri:refri@db:5432/refri
