# Copiar a .env y ajustar si hace falta. No subir .env con datos reales.

POSTGRES_USER=refri
# Debe ser URL-safe: `docker-compose.yml` arma la DATABASE_URL con esta contraseña, y un
# `@`, `/`, `:` o `#` dentro de ella parte mal la URL y el backend termina conectando a
# otro host. Si necesitás una contraseña con esos caracteres, percent-encodeala y fijá
# DATABASE_URL a mano (ver abajo).
POSTGRES_PASSWORD=refri
POSTGRES_DB=refri

# DATABASE_URL la compone `docker-compose.yml` a partir de las tres variables de arriba,
# así que normalmente NO hace falta fijarla acá: hacerlo es lo que rompía el cambio de
# contraseña (Postgres arrancaba con la nueva y el backend seguía usando la vieja).
#
# Descomentala solo para apuntar a una base que no es la de compose — por ejemplo para
# correr el backend fuera de docker, donde el host es "localhost" y no "db":
# DATABASE_URL=postgresql+psycopg://refri:refri@localhost:5432/refri

# URL de la API que usa el frontend. Se resuelve desde el navegador del usuario
# (no desde la red interna de docker compose), por eso apunta al puerto publicado.
VITE_API_URL=http://localhost:8000

# Orígenes desde los que el backend acepta llamadas del frontend (CORS), separados
# por coma. Debe incluir el origen público del frontend (arriba, sin VITE_ y con
# el puerto publicado, no el interno).
CORS_ORIGINS=http://localhost:5173
